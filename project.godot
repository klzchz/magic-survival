; Engine configuration file — Hollow Hallows (Godot 3.5.x)
; 3D survival prototype, Don't Starve inspired, original witchcraft world.

config_version=4

[application]

config/name="Hollow Hallows"
config/description="Survival de bruxaria em 3D — protótipo (Godot 3.5). Don't Starve inspired."
run/main_scene="res://main.tscn"

[display]

window/size/width=1280
window/size/height=720
window/stretch/mode="2d"
window/stretch/aspect="expand"

[rendering]

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
environment/default_clear_color=Color( 0.08, 0.09, 0.12, 1 )
quality/filters/msaa=1
